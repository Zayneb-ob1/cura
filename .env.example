NEXT_PUBLIC_SITE_URL=
CURA_ADMIN_USERNAME=your-admin-email@example.com
CURA_ADMIN_PASSWORD=replace-with-a-strong-password
CURA_ADMIN_SESSION_SECRET=replace-with-a-long-random-secret
CURA_ALLOWED_ADMIN_ORIGINS=
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=cpanel_database_name
MYSQL_USER=cpanel_database_user
MYSQL_PASSWORD=replace-with-database-password
MYSQL_CONNECTION_LIMIT=2
MYSQL_MAX_IDLE=1
MYSQL_IDLE_TIMEOUT_MS=60000
MYSQL_CONNECT_TIMEOUT_MS=10000
# Set MYSQL_SSL=true for hosted providers that require TLS.
MYSQL_SSL=false
# Optional PEM certificate. Use literal \\n sequences when stored on one line.
MYSQL_SSL_CA=
MYSQL_SSL_REJECT_UNAUTHORIZED=true

# Outgoing email. Use port 465 with SMTP_SECURE=true, or port 587 with SMTP_SECURE=false.
CONTACT_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS_REJECT_UNAUTHORIZED=true

# Public clinic details. Leave an unknown value empty; the site shows neutral text instead.
NEXT_PUBLIC_CLINIC_NAME=CURA Tandarts Praktijk
NEXT_PUBLIC_CLINIC_ADDRESS_LINE_1=
NEXT_PUBLIC_CLINIC_POSTAL_CITY=
NEXT_PUBLIC_CLINIC_CITY=
NEXT_PUBLIC_CLINIC_PHONE_DISPLAY=
NEXT_PUBLIC_CLINIC_PHONE=
NEXT_PUBLIC_CLINIC_EMAIL=
NEXT_PUBLIC_CLINIC_MAP_URL=
NEXT_PUBLIC_CLINIC_SCHEDULE_FR=
NEXT_PUBLIC_CLINIC_SCHEDULE_NL=
NEXT_PUBLIC_CLINIC_EMERGENCY_FR=
NEXT_PUBLIC_CLINIC_EMERGENCY_NL=
# Seven day values from Monday to Sunday, separated by | characters. Use "closed" for a closed day.
NEXT_PUBLIC_CLINIC_HOURS=08:30–18:00|08:30–18:00|08:30–18:00|08:30–18:00|08:30–17:00|09:00–13:00|closed

# Google Calendar displayed in the protected admin agenda. These values are public and contain no password.
NEXT_PUBLIC_GOOGLE_CALENDAR_ID=contact@curadental.be
NEXT_PUBLIC_GOOGLE_CALENDAR_TIME_ZONE=Europe/Brussels
# Optional complete iframe src from Google Calendar > Settings > Integrate calendar.
NEXT_PUBLIC_GOOGLE_CALENDAR_EMBED=

# Private Google Calendar API credentials used to create/update confirmed appointments.
# Required OAuth set: CALENDAR_ID + CLIENT_ID + CLIENT_SECRET + REFRESH_TOKEN.
# The OAuth consent must include https://www.googleapis.com/auth/calendar.events and
# the refresh token must belong to a Google user with write access to this calendar.
GOOGLE_CALENDAR_ID=contact@curadental.be
GOOGLE_CALENDAR_TIME_ZONE=Europe/Brussels
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=

# Legal details. These must be supplied and approved by the clinic before launch.
NEXT_PUBLIC_LEGAL_OPERATOR=
NEXT_PUBLIC_LEGAL_REGISTRATION=
NEXT_PUBLIC_LEGAL_PRIVACY_EMAIL=
NEXT_PUBLIC_LEGAL_HOST=
NEXT_PUBLIC_LEGAL_RETENTION_FR=
NEXT_PUBLIC_LEGAL_RETENTION_NL=
